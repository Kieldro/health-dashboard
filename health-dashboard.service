[Unit]
Description=Health Dashboard Server
# No After=/Wants=network-online.target: that target doesn't exist in the user
# manager (it was a silent no-op), and the server only binds 127.0.0.1 anyway.

[Service]
Type=simple
WorkingDirectory=/home/keo/repos/health-dashboard
ExecStart=/usr/bin/python3 /home/keo/repos/health-dashboard/serve.py
# always, not on-failure: also come back after a clean exit or a stray SIGTERM.
Restart=always
RestartSec=5
# One thread per request; cap them so a connection flood can't exhaust the
# user's process limit. serve.py sheds connections over the cap and keeps going.
TasksMax=256
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
